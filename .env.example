# Configuration CERBERUS V1
# Clé API Google Gemini (optionnelle pour les tests locaux grâce au mode déterministe)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# Mode Calibration V0 : si true, 100% des messages sont retenus en brouillon pour validation humaine par Akim
CERBERUS_CALIBRATION_MODE=true

# Ports et configuration serveur local
CERBERUS_PORT=8000
CERBERUS_HOST=127.0.0.1
